# Prometheus configuration for Goose metrics
# Copy this file to your Prometheus configuration directory and update paths as needed

global:
  scrape_interval: 30s
  evaluation_interval: 30s
  external_labels:
    cluster: 'goose'
    environment: 'development'

# Scrape configurations
scrape_configs:
  # Goose Prometheus Exporter
  - job_name: 'goose-metrics'
    scrape_interval: 30s
    scrape_timeout: 10s
    metrics_path: '/metrics'
    static_configs:
      - targets: ['localhost:9090']
        labels:
          service: 'goose'
          exporter: 'prometheus-exporter'

  # Optional: If you have multiple Goose instances
  # - job_name: 'goose-metrics-instance-2'
  #   static_configs:
  #     - targets: ['other-host:9090']

# Alerting rules (optional)
# rule_files:
#   - 'goose_alerts.yml'

# Alertmanager configuration (optional)
# alerting:
#   alertmanagers:
#     - static_configs:
#         - targets: ['localhost:9093']

